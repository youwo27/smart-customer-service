# ============ LLM（默认 DeepSeek，OpenAI 兼容协议） ============
LLM_PROVIDER=deepseek              # deepseek | anthropic | openai
LLM_API_KEY=sk-your-deepseek-key   # DeepSeek API Key（https://platform.deepseek.com）
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat            # 通用对话（DeepSeek-V3.x）
LLM_FAST_MODEL=deepseek-chat       # 简单/快速任务；复杂推理可换 deepseek-reasoner

# === 若切回 Anthropic，启用下面三行并改 LLM_PROVIDER=anthropic ===
# ANTHROPIC_API_KEY=sk-ant-xxx
# LLM_MODEL=claude-sonnet-5-20251001
# LLM_FAST_MODEL=claude-haiku-4-5-20251001

# ============ Embedding（智谱 embedding-3，中文效果好；也可用 chroma 内置离线跑通） ============
EMBEDDING_PROVIDER=zhipu          # zhipu | chroma
EMBEDDING_API_KEY=                # 智谱 key（https://open.bigmodel.cn）
EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
EMBEDDING_MODEL=embedding-3

# ============ Rerank（硅基流动 bge-reranker；留空则跳过重排） ============
RERANK_PROVIDER=siliconflow
RERANK_API_KEY=
RERANK_BASE_URL=https://api.siliconflow.cn/v1
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ============ Database ============
DATABASE_URL=postgresql+asyncpg://agent:agent123@localhost:5432/agent_db

# ============ Redis ============
REDIS_URL=redis://localhost:6379/0

# ============ ChromaDB ============
CHROMA_PERSIST_DIR=./data/chroma

# ============ Server ============
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# ============ Agent ============
MAX_TURNS=15
TOOL_TIMEOUT_SECONDS=30
LLM_RETRY_MAX=3
LLM_RETRY_BASE_DELAY=1.0

# ============ Context ============
MAX_CONTEXT_TOKENS=180000
COMPRESSION_THRESHOLD_TOKENS=150000
COMPRESSION_KEEP_RECENT=8

# ============ Session（会话持久化，Day 7） ============
SESSION_STORE_BACKEND=memory   # memory（开发/测试） | sqlite（重启恢复）
SESSION_STORE_PATH=./data/sessions.db
